{
  "singleQuote": false,
  "bracketSameLine": true,
  "arrowParens": "avoid",
  "experimentalOperatorPosition": "start",
  "experimentalTernaries": true,
  "plugins": [
    "prettier-plugin-tailwindcss"
  ],
  "tailwindStylesheet": "./assets/globals.css",
  "tailwindFunctions": [
    "cn",
    "cva"
  ]
}
